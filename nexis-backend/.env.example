# Nexis Backend Core Configuration
PROJECT_NAME="Nexis Core Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Ollama Local Service Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=120.0

# Repository Roots Storage
REPOS_STORAGE_PATH="/srv/repos"

# SQLite Database Configuration
SQLITE_DB_PATH="data/nexis.db"

# Security & API Ingestion Key (Change to your secret 32-char string)
API_KEY_SECRET="change-this-to-a-secure-32-char-random-string"
ALLOWED_HOSTS=["*"]

# Cloud Providers & Observability (Optional personal tokens)
VERCEL_API_TOKEN=""
VERCEL_API_KEY=""
RENDER_API_TOKEN=""
VERCEL_PROJECT_NAME=""
